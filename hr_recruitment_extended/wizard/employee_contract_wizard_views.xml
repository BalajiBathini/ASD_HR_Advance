<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_applicant_employee_contract_wizard_form" model="ir.ui.view">
        <field name="name">applicant.employee.contract.wizard.form</field>
        <field name="model">applicant.employee.contract.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Employee &amp; Contract">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Employee Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Employee Details">
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                            <field name="job_id"/>
                            <field name="department_id"/>
                            <field name="marital" widget="radio" options="{'horizontal': True}"/>
                        </group>
                        <group string="Contract Details">
                            <field name="contract_start_date"/>
                            <field name="struct_id" options="{'no_create': True}"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="main_ctc"/>
                            <field name="monthly_ctc" readonly="1" force_save="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create" string="Create" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
