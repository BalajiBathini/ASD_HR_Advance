    <record id="hr_induction_stage_list_view" model="ir.ui.view">
        <field name="name">hr.induction.stage.list</field>
        <field name="model">hr.induction.stage</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="sequence"/>
                <field name="fold"/>
                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="hr_induction_stage_search_view" model="ir.ui.view">
        <field name="name">hr.induction.stage.search</field>
        <field name="model">hr.induction.stage</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Folded" name="folded" domain="[('fold', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_hr_induction_stage" model="ir.actions.act_window">
        <field name="name">Induction Stages</field>
        <field name="res_model">hr.induction.stage</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="hr_induction_stage_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define stages for induction processes
            </p>
            <p>
                Manage the stages that inductions and department sessions go through.
            </p>
        </field>
    </record>

    <record id="hr_induction_list_view" model="ir.ui.view">
        <field name="name">hr.induction.list</field>
        <field name="model">hr.induction</field>
        <field name="arch" type="xml">
            <list decoration-info="stage_name == 'Draft'" decoration-success="stage_name == 'Completed'">
                <field name="sr_no"/>
                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" optional="hide"/>
                <field name="employee_id"/>
                <field name="employee_code"/>
                <field name="department_id"/>
                <field name="hod_id"/>
                <field name="joining_date"/>
                <field name="stage_id"/>
                <field name="stage_name" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="hr_induction_form_view" model="ir.ui.view">
        <field name="name">hr.induction.form</field>
        <field name="model">hr.induction</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_schedule" string="Schedule" type="object" 
                            invisible="stage_name != 'Draft'" 
                            class="btn-primary" icon="fa-calendar-check-o"/>
                    <button name="action_complete" string="Complete" type="object" 
                            invisible="stage_name != 'Scheduled'" 
                            class="btn-success" icon="fa-check-circle"/>
                    <button name="action_cancel" string="Cancel" type="object" 
                            invisible="stage_name not in ['Draft', 'Scheduled']" 
                            class="btn-danger" icon="fa-times"/>
                    <button name="action_undo" string="Undo" type="object" 
                            invisible="stage_name not in ['Scheduled', 'Completed', 'Cancelled']" 
                            class="btn-warning" icon="fa-undo"/>
                    <field name="stage_id" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sr_no" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="employee_id" options="{'no_create': True}" domain="[('company_id', 'in', [False, company_id])]"/>
                            <field name="employee_code" readonly="0"/>
                            <field name="department_id" readonly="0"/>
                            <field name="hod_id" readonly="0"/>
                            <field name="joining_date" readonly="0"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Department Inductions">
                            <field name="department_line_ids">
                                <list editable="bottom" decoration-success="stage_name == 'Completed'" decoration-info="stage_name == 'Draft'">
                                    <field name="sr_no" readonly="1"/>
                                    <field name="department_id" options="{'no_create': True}" domain="[('company_id', 'in', [False, parent.company_id])]"/>
                                    <field name="induction_datetime_from" required="1"/>
                                    <field name="induction_datetime_to" required="1" />
                                    <field name="duration" widget="float_time"/>
                                    <field name="assigned_to" options="{'no_create': True}"  required="1" domain="[('company_id', 'in', [False, parent.company_id])]"/>
                                    <field name="remarks"  required="1"/>
                                    <field name="stage_id"/>
                                    <!-- <field name="stage_name" invisible="0" /> -->
                                    <!-- <field name="attendance_marked" invisible="0"/> -->
                                    <button name="action_mark_attendance" string="Mark Attendance" type="object" 
                                            invisible="stage_name != 'Draft'" 
                                            icon="fa-check-circle" class="btn-info"/>
                                    <button name="action_complete" string="Complete" type="object" 
                                            invisible="stage_name != 'Scheduled' or not attendance_marked" 
                                            icon="fa-trophy" class="btn-success"/>
                                    <button name="action_cancel" string="Cancel" type="object" 
                                            invisible="stage_name not in ['Draft', 'Scheduled']" 
                                            icon="fa-times" class="btn-danger"/>
                                    <button name="action_undo" string="Undo" type="object" 
                                            invisible="stage_name not in ['Scheduled', 'Completed', 'Cancelled']" 
                                            icon="fa-undo" class="btn-warning"/>
                                </list>
                            </field>
                        </page>
                        <page string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_induction_kanban_view" model="ir.ui.view">
        <field name="name">hr.induction.kanban</field>
        <field name="model">hr.induction</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="joining_date"/>
                <field name="stage_id"/>
                <field name="stage_name"/>
                <field name="department_line_ids"/>
                <field name="activity_ids"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record o_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('hr.employee', 'image_128', record.employee_id.raw_value)"
                                     class="oe_kanban_avatar"
                                     t-att-alt="record.employee_id.value"
                                     t-att-title="record.employee_id.value"/>
                            </div>
                            <div class="o_kanban_details">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <div class="o_kanban_record_subtitle text-muted">
                                        <field name="department_id"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div>
                                        <i class="fa fa-calendar fa-fw" title="Joining Date"/> <field name="joining_date"/>
                                    </div>
                                    <div>
                                        <i class="fa fa-list fa-fw" title="Sessions"/> <span t-esc="record.department_line_ids.length"/> Sessions
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="activity_ids" widget="kanban_activity"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <div t-attf-class="badge #{record.stage_name.value == 'Draft' and 'badge-secondary' or record.stage_name.value == 'Scheduled' and 'badge-info' or record.stage_name.value == 'Completed' and 'badge-success' or 'badge-danger'}">
                                            <field name="stage_id"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="hr_induction_department_line_list_view" model="ir.ui.view">
        <field name="name">hr.induction.department.line.list</field>
        <field name="model">hr.induction.department.line</field>
        <field name="arch" type="xml">
            <list decoration-success="stage_name == 'Completed'" decoration-info="stage_name == 'Draft'">
                <field name="sr_no"/>
                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" optional="hide"/>
                <field name="induction_id"/>
                <field name="department_id"/>
                <field name="induction_datetime_from"/>
                <field name="induction_datetime_to"/>
                <field name="duration" widget="float_time"/>
                <field name="assigned_to"/>
                <field name="remarks"/>
                <field name="stage_id"/>
                <field name="stage_name" invisible="1"/>
                <field name="attendance_marked"/>
            </list>
        </field>
    </record>

    <record id="hr_induction_department_line_form_view" model="ir.ui.view">
        <field name="name">hr.induction.department.line.form</field>
        <field name="model">hr.induction.department.line</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_attendance" string="Mark Attendance" type="object" 
                            invisible="stage_name != 'Draft'" 
                            class="oe_highlight"/>
                    <button name="action_complete" string="Complete" type="object" 
                            invisible="stage_name != 'Scheduled' or not attendance_marked" 
                            class="oe_highlight"/>
                    <button name="action_cancel" string="Cancel" type="object" 
                            invisible="stage_name not in ['Draft', 'Scheduled']" 
                            class="oe_highlight"/>
                    <button name="action_undo" string="Undo" type="object" 
                            invisible="stage_name not in ['Scheduled', 'Completed', 'Cancelled']" 
                            class="oe_highlight"/>
                    <field name="stage_id" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="sr_no" readonly="1"/>
                            <field name="induction_id" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="department_id" options="{'no_create': True}" domain="[('company_id', 'in', [False, company_id])]"/>
                            <field name="induction_datetime_from" />
                            <field name="induction_datetime_to" />
                            <field name="duration" widget="float_time" readonly="1"/>
                            <field name="assigned_to" options="{'no_create': True}" domain="[('company_id', 'in', [False, company_id])]"/>
                        </group>
                        <group>
                            <field name="remarks" />
                            <field name="attendance_marked" invisible="1" widget="boolean"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_induction_search_view" model="ir.ui.view">
        <field name="name">hr.induction.search</field>
        <field name="model">hr.induction</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="joining_date"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('stage_name', '=', 'Draft')]"/>
                <filter string="Scheduled" name="scheduled" domain="[('stage_name', '=', 'Scheduled')]"/>
                <filter string="Completed" name="completed" domain="[('stage_name', '=', 'Completed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Department" name="department" context="{'group_by': 'department_id'}"/>
                    <filter string="Stage" name="stage" context="{'group_by': 'stage_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hr_induction_department_line_search_view" model="ir.ui.view">
        <field name="name">hr.induction.department.line.search</field>
        <field name="model">hr.induction.department.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="induction_id"/>
                <field name="department_id"/>
                <field name="assigned_to"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('stage_name', '=', 'Draft')]"/>
                <filter string="Scheduled" name="scheduled" domain="[('stage_name', '=', 'Scheduled')]"/>
                <filter string="Completed" name="completed" domain="[('stage_name', '=', 'Completed')]"/>
                <filter string="Attendance Marked" name="attendance_marked" domain="[('attendance_marked', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Department" name="department" context="{'group_by': 'department_id'}"/>
                    <filter string="Stage" name="stage" context="{'group_by': 'stage_id'}"/>
                    <filter string="Assigned To" name="assigned_to" context="{'group_by': 'assigned_to'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_department_form_inherit_induction" model="ir.ui.view">
        <field name="name">hr.department.form.inherit.induction</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_induction_sessions" type="object" class="oe_stat_button" icon="fa-graduation-cap">
                    <field name="induction_session_count" widget="statinfo" string="Induction Sessions"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="action_hr_induction" model="ir.actions.act_window">
        <field name="name">Induction Schedules</field>
        <field name="res_model">hr.induction</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="search_view_id" ref="hr_induction_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new induction schedule
            </p>
            <p>
                Manage induction schedules for new employees across departments.
            </p>
        </field>
    </record>

    <record id="action_hr_induction_department_line" model="ir.actions.act_window">
        <field name="name">Induction Department Lines</field>
        <field name="res_model">hr.induction.department.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_induction_department_line_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No induction department lines found
            </p>
            <p>
                Manage induction sessions per department within induction schedules.
            </p>
        </field>
    </record>

    <menuitem id="menu_hr_induction_main" name="Employees Induction" sequence="215"/>
    <menuitem id="menu_hr_induction" name="Induction Schedules" parent="menu_hr_induction_main" action="action_hr_induction" sequence="10" groups="hr.group_hr_user,hr.group_hr_manager"/>
    <menuitem id="menu_hr_induction_department_line" name="Department Wise Induction Sessions" parent="menu_hr_induction_main" action="action_hr_induction_department_line" sequence="15" groups="hr.group_hr_user,hr.group_hr_manager"/>
    <menuitem id="menu_hr_induction_stage" name="Stages" parent="menu_hr_induction_main" action="action_hr_induction_stage" sequence="20" groups="hr.group_hr_manager"/>
</odoo>