<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- My Inductions Portal Menu -->
    <record id="portal_my_inductions_menu" model="ir.ui.view">
        <field name="name">portal.my.inductions.menu</field>
        <field name="inherit_id" ref="portal.portal_my_home"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
                <div class="col-lg-4">
                    <a href="/my/inductions">
                        <div class="o_portal_link_block card mb-4 shadow-sm">
                            <div class="card-body">
                                <div class="row align-items-center">
                                    <div class="col-3 text-right">
                                        <i class="fa fa-graduation-cap fa-3x text-primary"></i>
                                    </div>
                                    <div class="col-9">
                                        <h5>My Inductions</h5>
                                        <p class="text-muted">View your scheduled inductions</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Portal My Inductions Template -->
    <template id="portal_my_inductions" name="My Inductions">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Inductions</t>
            </t>
            <t t-if="inductions">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr class="active">
                                <th>Sr. No.</th>
                                <th>Department</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="inductions" t-as="induction">
                                <tr>
                                    <td><a t-att-href="'/my/induction/%s' % induction.id"><t t-esc="induction.sr_no"/></a></td>
                                    <td><t t-esc="induction.department_id.name"/></td>
                                    <td><t t-esc="induction.induction_datetime_from.date()"/></td>
                                    <td><t t-esc="induction.induction_datetime_from.strftime('%H:%M')"/> - <t t-esc="induction.induction_datetime_to.strftime('%H:%M')"/></td>
                                    <td><span t-field="induction.stage_id" class="badge badge-pill badge-primary"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
            <t t-else="">
                <div class="alert alert-info">
                    <p>There are currently no inductions scheduled for you.</p>
                </div>
            </t>
        </t>
    </template>

    <!-- Portal Induction Detail Template -->
    <template id="portal_my_induction" name="My Induction">
        <t t-call="portal.portal_layout">
            <t t-set="o_portal_fullwidth_alert" groups="hr.group_hr_manager">
                <t t-call="portal.portal_back_in_edit_mode">
                    <t t-set="backend_url" t-value="'/web#id=%s&amp;view_type=form&amp;model=hr.induction.department.line' % (induction.id)"/>
                </t>
            </t>
            <div class="row mt-4">
                <div class="col-lg-12">
                    <div class="card">
                        <div class="card-header">
                            <h3>Induction Details</h3>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-6">
                                    <p><strong>Department:</strong> <span t-field="induction.department_id.name"/></p>
                                    <p><strong>Date:</strong> <span t-field="induction.induction_datetime_from" t-options="{'widget': 'date'}"/></p>
                                    <p><strong>Time:</strong> <span t-field="induction.induction_datetime_from" t-options="{'time_only': True}"/> - <span t-field="induction.induction_datetime_to" t-options="{'time_only': True}"/></p>
                                    <p><strong>Duration:</strong> <span t-field="induction.duration" t-options="{'widget': 'float_time'}"/> hours</p>
                                </div>
                                <div class="col-lg-6">
                                    <p><strong>Status:</strong> <span t-field="induction.stage_id" class="badge badge-pill badge-primary"/></p>
                                    <p><strong>Attendance:</strong> <span t-if="induction.attendance_marked" class="badge badge-success">Marked</span>
                                    <span t-else="" class="badge badge-danger">Not Marked</span></p>
                                </div>
                            </div>
                            <div class="row mt-4" t-if="induction.remarks">
                                <div class="col-lg-12">
                                    <h5>Remarks</h5>
                                    <p t-field="induction.remarks"/>
                                </div>
                            </div>
                            <div class="row mt-4">
                                <div class="col-lg-12">
                                    <h5>My Feedback</h5>
                                    <form t-if="induction.stage_id.name == 'Completed'" action="/my/induction/feedback" method="post" enctype="multipart/form-data">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <input type="hidden" name="induction_id" t-att-value="induction.id"/>
                                        <div class="form-group">
                                            <textarea class="form-control" name="feedback" rows="4" t-esc="induction.remarks"></textarea>
                                        </div>
                                        <div class="form-group">
                                            <label for="attachment">Attachments</label>
                                            <input type="file" class="form-control-file" name="attachment" multiple="multiple"/>
                                        </div>
                                        <button type="submit" class="btn btn-primary">Submit Feedback</button>
                                    </form>
                                    <div t-else="">
                                        <p t-if="induction.remarks" t-field="induction.remarks"/>
                                        <p t-else="" class="text-muted">You can provide feedback once the induction is completed.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-4" t-if="induction.attachment_ids">
                                <div class="col-lg-12">
                                    <h5>Attachments</h5>
                                    <ul class="list-group">
                                        <t t-foreach="induction.attachment_ids" t-as="attachment">
                                            <li class="list-group-item">
                                                <a t-att-href="'/web/content/%s?download=true' % attachment.id">
                                                    <span class="fa fa-download"/> <t t-esc="attachment.name"/>
                                                </a>
                                            </li>
                                        </t>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>