<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_appraisal_kpi_view_list" model="ir.ui.view">
        <field name="name">hr.appraisal.kpi.list</field>
        <field name="model">hr.appraisal.kpi</field>
        <field name="arch" type="xml">
            <list string="KPIs" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="employee_id"/>
                <field name="kra_id"/>
                <field name="kpi_name"/>
                <field name="uom"/>
                <field name="target_value"/>
                <field name="actual_value"/>
                <field name="achievement_pct" widget="percentage"/>
                <field name="bell_curve_rating"/>
                <field name="carry_to_next_cycle"/>
            </list>
        </field>
    </record>

    <record id="hr_appraisal_kpi_view_form" model="ir.ui.view">
        <field name="name">hr.appraisal.kpi.form</field>
        <field name="model">hr.appraisal.kpi</field>
        <field name="arch" type="xml">
            <form string="KPI">
                <sheet>
                    <group>
                        <field name="appraisal_id"/>
                        <field name="kra_id"/>
                        <field name="kpi_name"/>
                        <field name="uom"/>
                        <field name="target_value"/>
                        <field name="actual_value"/>
                        <field name="achievement_pct" widget="percentage"/>
                        <field name="bell_curve_rating"/>
                        <field name="carry_to_next_cycle"/>
                        <field name="from_kpi_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_appraisal_kpi_action" model="ir.actions.act_window">
        <field name="name">KPIs</field>
        <field name="res_model">hr.appraisal.kpi</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
