<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_appraisal_kra_view_list" model="ir.ui.view">
        <field name="name">hr.appraisal.kra.list</field>
        <field name="model">hr.appraisal.kra</field>
        <field name="arch" type="xml">
            <list string="Key Result Areas" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="employee_id"/>
                <field name="name"/>
                <field name="weightage" sum="Total"/>
                <field name="achievement_pct" widget="percentage"/>
                <field name="kpi_count"/>
            </list>
        </field>
    </record>

    <record id="hr_appraisal_kra_view_form" model="ir.ui.view">
        <field name="name">hr.appraisal.kra.form</field>
        <field name="model">hr.appraisal.kra</field>
        <field name="arch" type="xml">
            <form string="Key Result Area">
                <sheet>
                    <group>
                        <field name="appraisal_id"/>
                        <field name="name"/>
                        <field name="weightage"/>
                        <field name="achievement_pct" widget="percentage"/>
                        <field name="description"/>
                    </group>
                    <field name="kpi_ids">
                        <list editable="bottom">
                            <field name="kpi_name"/>
                            <field name="uom"/>
                            <field name="target_value"/>
                            <field name="actual_value"/>
                            <field name="achievement_pct" widget="percentage"/>
                            <field name="bell_curve_rating"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_appraisal_kra_action" model="ir.actions.act_window">
        <field name="name">Key Result Areas (KRA)</field>
        <field name="res_model">hr.appraisal.kra</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
