<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_appraisal_template_view_list" model="ir.ui.view">
        <field name="name">hr.appraisal.template.list</field>
        <field name="model">hr.appraisal.template</field>
        <field name="arch" type="xml">
            <list string="Appraisal Templates">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="hr_appraisal_template_view_form" model="ir.ui.view">
        <field name="name">hr.appraisal.template.form</field>
        <field name="model">hr.appraisal.template</field>
        <field name="arch" type="xml">
            <form string="Appraisal Template">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Template Name"/></h1>
                    </div>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Employee Self Assessment">
                            <field name="employee_feedback_template"/>
                        </page>
                        <page string="Manager Feedback">
                            <field name="manager_feedback_template"/>
                        </page>
                        <page string="Default KRAs">
                            <field name="default_kra_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="weightage" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_appraisal_template_action" model="ir.actions.act_window">
        <field name="name">Appraisal Templates</field>
        <field name="res_model">hr.appraisal.template</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
