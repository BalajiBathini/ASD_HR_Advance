<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_hr_appraisal_kpi" model="ir.module.category">
            <field name="name">Appraisal KPI</field>
            <field name="sequence">15</field>
        </record>

        <record id="group_appraisal_user" model="res.groups">
            <field name="name">Employee</field>
            <field name="category_id" ref="module_category_hr_appraisal_kpi"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_appraisal_manager" model="res.groups">
            <field name="name">Officer: Manage all appraisals</field>
            <field name="category_id" ref="module_category_hr_appraisal_kpi"/>
            <field name="implied_ids" eval="[(4, ref('group_appraisal_user'))]"/>
        </record>

        <record id="group_appraisal_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_hr_appraisal_kpi"/>
            <field name="implied_ids" eval="[(4, ref('group_appraisal_manager'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- Record rule: employees can read their own appraisals -->
        <record id="hr_appraisal_rule_employee" model="ir.rule">
            <field name="name">Appraisal: Employee sees own</field>
            <field name="model_id" ref="model_hr_appraisal"/>
            <field name="domain_force">
                ['|', '|',
                    ('employee_id.user_id', '=', user.id),
                    ('manager_ids.user_id', '=', user.id),
                    ('employee_id.user_id', '=', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('group_appraisal_user'))]"/>
        </record>

        <record id="hr_appraisal_rule_manager" model="ir.rule">
            <field name="name">Appraisal: Manager/Admin sees all</field>
            <field name="model_id" ref="model_hr_appraisal"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_appraisal_manager'))]"/>
        </record>

    </data>
</odoo>
