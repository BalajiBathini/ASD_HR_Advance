<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Record rules for Multi-Company -->
    <record id="attendance_monthly_balance_comp_rule" model="ir.rule">
        <field name="name">Attendance Monthly Balance multi-company</field>
        <field name="model_id" ref="model_attendance_monthly_balance"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="attendance_monthly_balance_employee_rule" model="ir.rule">
        <field name="name">Attendance Monthly Balance: Employee sees own data</field>
        <field name="model_id" ref="model_attendance_monthly_balance"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="attendance_monthly_balance_manager_rule" model="ir.rule">
        <field name="name">Attendance Monthly Balance: Manager sees all</field>
        <field name="model_id" ref="model_attendance_monthly_balance"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
    </record>
</odoo>
