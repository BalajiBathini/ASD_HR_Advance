<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_asd" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.asd</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_attendance_ledger" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-clock-o"
                        help="Working Hours Ledger"
                        invisible="not id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Hours Ledger</span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>
