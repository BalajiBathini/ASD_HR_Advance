<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_form_inherit_asd" model="ir.ui.view">
        <field name="name">hr.payslip.form.inherit.asd</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="payroll.hr_payslip_view_form"/>
        <field name="arch" type="xml">
            <page name="input" position="after">
                <page name="working_hours_ledger" string="Working Hours Balance">
                    <group>
                        <group>
                            <field name="asd_monthly_balance_id"/>
                            <field name="asd_is_salary_eligible" decoration-danger="not asd_is_salary_eligible"/>
                        </group>
                        <group invisible="not asd_monthly_balance_id">
                            <field name="asd_norm_hours"/>
                            <field name="asd_actual_worked"/>
                            <field name="asd_total_available"/>
                            <field name="asd_remaining_balance"/>
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>
