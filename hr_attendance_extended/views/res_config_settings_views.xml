<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.asd.hr.advance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr_attendance']" position="inside">
                <block title="Advanced Attendance &amp; Working Hours" name="asd_hr_settings">
                    <setting string="Daily Working Hours" help="Standard daily working hours for calculation">
                        <field name="asd_daily_working_hours"/>
                    </setting>
                    <setting string="Weekly Offs Count" help="Standard weekly offs per month">
                        <field name="asd_weekly_offs_count"/>
                    </setting>
                    <setting string="Carry Forward" help="Enable carry forward of extra hours to next month">
                        <field name="asd_carry_forward_enabled"/>
                    </setting>
                    <setting string="Minimum Payable Hours" help="Minimum hours required for full salary eligibility">
                        <field name="asd_minimum_payable_hours"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
