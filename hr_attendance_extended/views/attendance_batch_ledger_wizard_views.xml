<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_batch_ledger_list" model="ir.ui.view">
        <field name="name">attendance.batch.ledger.list</field>
        <field name="model">attendance.batch.ledger</field>
        <field name="arch" type="xml">
            <list string="Batch Work Hour Ledgers">
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="all_employees"/>
            </list>
        </field>
    </record>

    <record id="view_attendance_batch_ledger_form" model="ir.ui.view">
        <field name="name">attendance.batch.ledger.form</field>
        <field name="model">attendance.batch.ledger</field>
        <field name="arch" type="xml">
            <form string="Batch Work Hour Ledger">
                <header>
                    <button string="Generate Records" name="action_generate_ledgers" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="all_employees"/>
                        </group>
                    </group>
                    <group>
                        <field name="employee_ids" widget="many2many_tags" invisible="all_employees" required="not all_employees"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_attendance_batch_ledger" model="ir.actions.act_window">
        <field name="name">Batch Work Hour Ledgers</field>
        <field name="res_model">attendance.batch.ledger</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Create the Parent Menu -->
    <menuitem id="menu_working_hours_parent" 
              name="Working Hours" 
              parent="hr_attendance.menu_hr_attendance_root" 
              sequence="20"/>

    <menuitem id="menu_attendance_batch_ledger_wizard" 
              name="Batch Work Hour Ledgers" 
              parent="menu_working_hours_parent" 
              sequence="20"
              action="action_attendance_batch_ledger"/>
</odoo>
