<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_compute_monthly_balances" model="ir.cron">
            <field name="name">Attendance: Compute Monthly Balances</field>
            <field name="model_id" ref="model_attendance_monthly_balance"/>
            <field name="state">code</field>
            <field name="code">model.compute_monthly_balances()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>

            <field name="nextcall" eval="(DateTime.now() + relativedelta(months=1, day=1, hour=1, minute=0)).strftime('%Y-%m-%d %H:%M:%S')" />
        </record>
    </data>
</odoo>
