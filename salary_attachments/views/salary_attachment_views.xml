<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_salary_attachment_form" model="ir.ui.view">
        <field name="name">salary.attachment.form</field>
        <field name="model">salary.attachment</field>
        <field name="arch" type="xml">
            <form string="Salary Attachment">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state != 'draft'"/>
                    <button name="mark_as_completed" string="Mark as Completed" type="object" invisible="state != 'active'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Personal Loan 2026"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="attachment_type"/>
                            <field name="start_month"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="is_percentage" invisible="attachment_type in ['loan', 'advance']"/>
                            <field name="percentage" invisible="is_percentage == False"/>
                            <field name="total_amount" invisible="is_percentage == True"/>
                            <field name="emi_amount" invisible="is_percentage == True"/>
                            <field name="recovered_amount" invisible="is_percentage == True"/>
                            <field name="balance_amount" invisible="is_percentage == True" decoration-bf="1" decoration-info="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_salary_attachment_tree" model="ir.ui.view">
        <field name="name">salary.attachment.list</field>
        <field name="model">salary.attachment</field>
        <field name="arch" type="xml">
            <list string="Salary Attachments" decoration-info="state == 'active'" decoration-success="state == 'completed'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="attachment_type"/>
                <field name="total_amount"/>
                <field name="recovered_amount"/>
                <field name="balance_amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_salary_attachment" model="ir.actions.act_window">
        <field name="name">Salary Attachments</field>
        <field name="res_model">salary.attachment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Loan, Advance or Deduction!
            </p>
        </field>
    </record>
</odoo>
