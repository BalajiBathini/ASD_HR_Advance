<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_state_salary_policy_tree" model="ir.ui.view">
        <field name="name">hr.state.salary.policy.tree</field>
        <field name="model">hr.state.salary.policy</field>
        <field name="arch" type="xml">
            <list string="State Salary Policies">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="country_id"/>
                <field name="state_id"/>
                <field name="min_ctc"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_hr_state_salary_policy_form" model="ir.ui.view">
        <field name="name">hr.state.salary.policy.form</field>
        <field name="model">hr.state.salary.policy</field>
        <field name="arch" type="xml">
            <form string="State Salary Policy">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Policy Name"/>
                        <h1><field name="name" placeholder="e.g. Maharashtra Minimum Wage"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="country_id" required="1"/>
                            <field name="state_id" domain="[('country_id', '=', country_id)]" readonly="not country_id"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="min_ctc" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_state_salary_policy" model="ir.actions.act_window">
        <field name="name">State Salary Policies</field>
        <field name="res_model">hr.state.salary.policy</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hr_state_salary_policy"
              name="State Salary Policies"
              parent="hr.menu_human_resources_configuration"
              action="action_hr_state_salary_policy"
              sequence="100"/>
</odoo>
