<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_contract_salary_decrease_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.contract.salary.decrease.wizard.form</field>
        <field name="model">hr.contract.salary.decrease.wizard</field>
        <field name="arch" type="xml">
            <form string="Salary Decrease Confirmation">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <strong>Warning!</strong><br/>
                        The Annual CTC is being reduced from <field name="previous_ctc" widget="monetary"/> to <field name="current_ctc" widget="monetary"/>.<br/>
                        This results in a salary decrease of <field name="amount_change" widget="monetary"/> (<field name="percentage_change"/>%).<br/><br/>
                        Are you sure you want to proceed with this salary reduction?
                    </div>
                    <group invisible="1">
                        <field name="contract_id"/>
                        <field name="currency_id"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_proceed" string="Proceed" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
