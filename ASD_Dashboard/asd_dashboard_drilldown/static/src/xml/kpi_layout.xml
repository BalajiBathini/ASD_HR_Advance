<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="asd_dashboard_drilldown.KPIView" t-inherit="asd_cust_dashboard.KPIView" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('oe_inner')]" position="attributes">
            <attribute name="t-on-click">onKpiClick</attribute>
            <attribute name="class" add="cursor-pointer" separator=" "/>
            <attribute name="style" add="cursor: pointer;" separator=";"/>
        </xpath>
    </t>
</templates>
