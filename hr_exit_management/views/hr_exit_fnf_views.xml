<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_exit_fnf_list" model="ir.ui.view">
        <field name="name">hr.exit.fnf.list</field>
        <field name="model">hr.exit.fnf</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'confirmed'">
                <field name="exit_id"/>
                <field name="employee_id"/>
                <field name="total_earnings" sum="Total Earnings"/>
                <field name="total_deductions" sum="Total Deductions"/>
                <field name="net_payable" sum="Net Payable"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_hr_exit_fnf_form" model="ir.ui.view">
        <field name="name">hr.exit.fnf.form</field>
        <field name="model">hr.exit.fnf</field>
        <field name="arch" type="xml">
            <form string="F&amp;F Settlement">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="oe_highlight" invisible="state == 'confirmed'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="exit_id"/>
                        <field name="employee_id" readonly="1"/>
                    </group>
                    <group string="Earnings">
                        <group>
                            <field name="pending_salary_days"/>
                            <field name="per_day_salary"/>
                            <field name="pending_salary" readonly="1"/>
                            <field name="el_encashment_days"/>
                            <field name="el_encashment" readonly="1"/>
                        </group>
                        <group>
                            <field name="gratuity_eligible"/>
                            <field name="last_drawn_basic"/>
                            <field name="years_of_service"/>
                            <field name="gratuity" readonly="1"/>
                            <field name="bonus_arrears"/>
                        </group>
                    </group>
                    <group string="Deductions">
                        <field name="notice_deduction_days"/>
                        <field name="notice_deduction" readonly="1"/>
                        <field name="loan_advance_deduction"/>
                        <field name="other_deductions"/>
                    </group>
                    <group string="Summary">
                        <field name="total_earnings" readonly="1"/>
                        <field name="total_deductions" readonly="1"/>
                        <field name="net_payable" readonly="1"/>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_exit_fnf" model="ir.actions.act_window">
        <field name="name">F&amp;F Settlements</field>
        <field name="res_model">hr.exit.fnf</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
