<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_hr_exit_form" model="ir.ui.view">
        <field name="name">hr.exit.form</field>
        <field name="model">hr.exit</field>
        <field name="arch" type="xml">
            <form string="Employee Exit Request">
                <header>
                    <button name="action_manager_accept" type="object" string="Manager Accept"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_hr_accept" type="object" string="HR Acknowledge"
                            class="oe_highlight" invisible="state != 'manager_accepted'"/>
                    <button name="action_start_clearance" type="object" string="Start Clearance"
                            class="oe_highlight" invisible="state != 'hr_accepted'"/>
                    <button name="action_revoke_access" type="object" string="Revoke System Access"
                            invisible="state != 'clearance' or access_revoked"/>
                    <button name="action_move_to_fnf" type="object" string="Proceed to F&amp;F"
                            class="oe_highlight" invisible="state != 'clearance'"/>
                    <button name="action_complete_fnf" type="object" string="Confirm F&amp;F"
                            class="oe_highlight" invisible="state != 'fnf'"/>
                    <button name="action_done" type="object" string="Issue Relieving Letter &amp; Archive"
                            class="oe_highlight" invisible="state != 'fnf'"/>
                    <button name="action_print_relieving_letter" type="object" string="Print Relieving Letter"
                            invisible="not relieving_letter_issued"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('cancelled',)"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,manager_accepted,hr_accepted,clearance,fnf,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" options="{'no_create': True}"/>
                            <field name="department_id" readonly="1"/>
                            <field name="job_id" readonly="1"/>
                            <field name="manager_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="resignation_date"/>
                            <field name="last_working_day"/>
                            <field name="required_notice_days"/>
                            <field name="notice_period_days" readonly="1"/>
                            <field name="notice_compliant" readonly="1" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Reason for Leaving">
                        <field name="reason" nolabel="1" placeholder="Primary reason for resignation..."/>
                    </group>

                    <notebook>
                        <page string="Knowledge Transfer">
                            <group>
                                <field name="kt_completed" widget="boolean_toggle"/>
                            </group>
                            <field name="kt_plan" placeholder="Document knowledge transfer plan..."/>
                        </page>

                        <page string="Asset Return">
                            <group>
                                <field name="pending_assets" readonly="1"/>
                                <p class="text-muted" invisible="pending_assets == 0">
                                    Employee has pending assets to return. F&amp;F settlement is blocked until all assets are returned.
                                </p>
                            </group>
                        </page>

                        <page string="Clearance Checklist" invisible="state == 'draft'">
                            <field name="all_cleared" invisible="1"/>
                            <field name="clearance_ids">
                                <list editable="bottom">
                                    <field name="department"/>
                                    <field name="item"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'cleared'"
                                           decoration-warning="status == 'pending'"
                                           decoration-muted="status == 'na'"/>
                                    <field name="remarks"/>
                                    <field name="cleared_by" readonly="1"/>
                                    <field name="cleared_date" readonly="1"/>
                                </list>
                            </field>
                        </page>

                        <page string="System Access" invisible="state == 'draft'">
                            <group>
                                <field name="access_revoked" widget="boolean_toggle"/>
                            </group>
                            <field name="access_revocation_notes"
                                   placeholder="Notes: email deactivated, ERP access removed, GitHub revoked, VPN disabled..."/>
                        </page>

                        <page string="F&amp;F Settlement" invisible="state in ('draft','manager_accepted','hr_accepted')">
                            <field name="fnf_id">
                                <list editable="bottom" decoration-success="state == 'confirmed'">
                                    <field name="pending_salary_days"/>
                                    <field name="per_day_salary"/>
                                    <field name="pending_salary" readonly="1"/>
                                    <field name="el_encashment_days"/>
                                    <field name="el_encashment" readonly="1"/>
                                    <field name="gratuity_eligible"/>
                                    <field name="last_drawn_basic"/>
                                    <field name="years_of_service"/>
                                    <field name="gratuity" readonly="1"/>
                                    <field name="bonus_arrears"/>
                                    <field name="notice_deduction_days"/>
                                    <field name="notice_deduction" readonly="1"/>
                                    <field name="loan_advance_deduction"/>
                                    <field name="other_deductions"/>
                                    <field name="total_earnings" readonly="1" sum="Total"/>
                                    <field name="total_deductions" readonly="1" sum="Total"/>
                                    <field name="net_payable" readonly="1" sum="Net Payable"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>

                        <page string="Exit Interview" invisible="state in ('draft','manager_accepted','hr_accepted')">
                            <field name="interview_id">
                                <list editable="bottom">
                                    <field name="interview_date"/>
                                    <field name="interviewer_id"/>
                                    <field name="reason"/>
                                    <field name="team_rating"/>
                                    <field name="manager_rating"/>
                                    <field name="suggestions"/>
                                    <field name="rehire_eligible"/>
                                </list>
                            </field>
                        </page>

                        <page string="Relieving" invisible="state != 'done'">
                            <group>
                                <field name="relieving_letter_issued" readonly="1" widget="boolean_toggle"/>
                                <field name="relieving_letter_date" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_hr_exit_list" model="ir.ui.view">
        <field name="name">hr.exit.list</field>
        <field name="model">hr.exit</field>
        <field name="arch" type="xml">
            <list string="Exit Requests" decoration-success="state == 'done'"
                  decoration-danger="state == 'cancelled'"
                  decoration-info="state == 'clearance'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="resignation_date"/>
                <field name="last_working_day"/>
                <field name="notice_period_days"/>
                <field name="notice_compliant" widget="boolean_toggle"/>
                <field name="pending_assets"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_hr_exit_kanban" model="ir.ui.view">
        <field name="name">hr.exit.kanban</field>
        <field name="model">hr.exit</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong><field name="employee_id"/></strong>
                            </div>
                            <div>
                                <field name="name"/>
                            </div>
                            <div>
                                Last Day: <field name="last_working_day"/>
                            </div>
                            <div t-if="record.pending_assets.raw_value &gt; 0" class="text-danger">
                                Pending Assets: <field name="pending_assets"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hr_exit_search" model="ir.ui.view">
        <field name="name">hr.exit.search</field>
        <field name="model">hr.exit</field>
        <field name="arch" type="xml">
            <search string="Exit Requests">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <filter string="Notice Non-Compliant" name="non_compliant" domain="[('notice_compliant','=',False)]"/>
                <filter string="Pending Assets" name="pending_assets" domain="[('pending_assets','&gt;',0)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="In Clearance" name="clearance" domain="[('state','=','clearance')]"/>
                <filter string="In F&amp;F" name="fnf" domain="[('state','=','fnf')]"/>
                <filter string="Done" name="done" domain="[('state','=','done')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Department" name="group_dept" context="{'group_by':'department_id'}"/>
                    <filter string="Last Working Day" name="group_lwd" context="{'group_by':'last_working_day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hr_exit" model="ir.actions.act_window">
        <field name="name">Exit Requests</field>
        <field name="res_model">hr.exit</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_hr_exit_search"/>
        <field name="context">{'search_default_group_state': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new employee exit / resignation request
            </p>
        </field>
    </record>

</odoo>
