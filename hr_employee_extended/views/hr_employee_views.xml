        </field>
    </record>

    <record id="view_res_bank_form_inherit_ifsc" model="ir.ui.view">
        <field name="name">res.bank.form.inherit.ifsc</field>
        <field name="model">res.bank</field>
        <field name="inherit_id" ref="base.view_res_bank_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='bic']" position="attributes">
                <attribute name="string">IFSC Code</attribute>
            </xpath>

        </field>
    </record>
    <record id="view_employee_tree_adding_imp_fields" model="ir.ui.view">
        <field name="name">hr.employee.tree.inherit.for.adding.important.fields</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <!-- <xpath expr="//list" position="attributes">
                <attribute name="editable">top</attribute>
            </xpath> -->

            <xpath expr="//list/field[@name='activity_ids']" position="replace">
                <field name="activity_ids" widget="list_activity" optional="hide"/>
            </xpath>
            <xpath expr="//list/field[@name='job_id']" position="attributes">
                <attribute name="string">Designation</attribute>
            </xpath>

            <xpath expr="//list/field[@name='coach_id']" position="attributes">
                <attribute name="string">In-Charge</attribute>
            </xpath>


            <!-- Add new fields -->
            <xpath expr="//list/field[@name='work_email']" position="after">
                <field name="employee_code"/>
                <field name="blood_group"/>
            </xpath>

        </field>
    </record>

