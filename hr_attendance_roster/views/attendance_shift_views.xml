<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_shift_master_tree" model="ir.ui.view">
        <field name="name">attendance.shift.master.tree</field>
        <field name="model">attendance.shift.master</field>
        <field name="arch" type="xml">
            <list string="Shifts">
                <field name="name"/>
                <field name="code"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="working_hours"/>
            </list>
        </field>
    </record>

    <record id="view_attendance_shift_master_form" model="ir.ui.view">
        <field name="name">attendance.shift.master.form</field>
        <field name="model">attendance.shift.master</field>
        <field name="arch" type="xml">
            <form string="Shift">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. General Shift"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                            <field name="grace_time" widget="float_time"/>
                            <field name="working_hours"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_attendance_shift_master" model="ir.actions.act_window">
        <field name="name">Shifts</field>
        <field name="res_model">attendance.shift.master</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Create a new Shift
          </p>
        </field>
    </record>
</odoo>
