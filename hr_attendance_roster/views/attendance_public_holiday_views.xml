<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_public_holiday_tree" model="ir.ui.view">
        <field name="name">attendance.public.holiday.tree</field>
        <field name="model">attendance.public.holiday</field>
        <field name="arch" type="xml">
            <list string="Public Holidays">
                <field name="name"/>
                <field name="date"/>
                <field name="department_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_attendance_public_holiday_form" model="ir.ui.view">
        <field name="name">attendance.public.holiday.form</field>
        <field name="model">attendance.public.holiday</field>
        <field name="arch" type="xml">
            <form string="Public Holiday">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="department_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_attendance_public_holiday" model="ir.actions.act_window">
        <field name="name">Public Holidays</field>
        <field name="res_model">attendance.public.holiday</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
