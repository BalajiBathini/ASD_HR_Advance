<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Attendance Policy Views -->
    <record id="view_hr_attendance_policy_tree" model="ir.ui.view">
        <field name="name">hr.attendance.policy.tree</field>
        <field name="model">hr.attendance.policy</field>
        <field name="arch" type="xml">
            <list string="Attendance Policies">
                <field name="name"/>
                <field name="late_grace_period"/>
                <field name="half_day_threshold"/>
                <field name="absent_threshold"/>
                <field name="overtime_start_after"/>
            </list>
        </field>
    </record>

    <record id="view_hr_attendance_policy_form" model="ir.ui.view">
        <field name="name">hr.attendance.policy.form</field>
        <field name="model">hr.attendance.policy</field>
        <field name="arch" type="xml">
            <form string="Attendance Policy">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Policy Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Timing Rules">
                            <field name="late_grace_period" widget="float_time" help="In minutes"/>
                        </group>
                        <group string="Thresholds (in Hours)">
                            <field name="half_day_threshold" widget="float_time"/>
                            <field name="absent_threshold" widget="float_time"/>
                            <field name="overtime_start_after" widget="float_time"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_attendance_policy" model="ir.actions.act_window">
        <field name="name">Attendance Policies</field>
        <field name="res_model">hr.attendance.policy</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Shift Roster Views -->
    <record id="view_hr_shift_roster_tree" model="ir.ui.view">
        <field name="name">hr.shift.roster.tree</field>
        <field name="model">hr.shift.roster</field>
        <field name="arch" type="xml">
            <list string="Shift Roster" editable="bottom">
                <field name="employee_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="shift_id"/>
                <field name="state" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="action_hr_shift_roster" model="ir.actions.act_window">
        <field name="name">Shift Roster</field>
        <field name="res_model">hr.shift.roster</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Regularization Views -->
    <record id="view_hr_attendance_regularization_tree" model="ir.ui.view">
        <field name="name">hr.attendance.regularization.tree</field>
        <field name="model">hr.attendance.regularization</field>
        <field name="arch" type="xml">
            <list string="Attendance Regularizations" decoration-info="state == 'draft'" decoration-warning="state == 'submitted'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'">
                <field name="employee_id"/>
                <field name="regularize_date"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="manager_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_hr_attendance_regularization_form" model="ir.ui.view">
        <field name="name">hr.attendance.regularization.form</field>
        <field name="model">hr.attendance.regularization</field>
        <field name="arch" type="xml">
            <form string="Attendance Regularization">
                <header>
                    <button string="Submit" name="action_submit" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button string="Approve" name="action_approve" type="object" invisible="state != 'submitted'" class="oe_highlight" groups="hr_attendance.group_hr_attendance_manager"/>
                    <button string="Reject" name="action_reject" type="object" invisible="state != 'submitted'" groups="hr_attendance.group_hr_attendance_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="regularize_date" readonly="state != 'draft'"/>
                            <field name="attendance_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="check_in" readonly="state != 'draft'"/>
                            <field name="check_out" readonly="state != 'draft'"/>
                            <field name="manager_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Reason">
                            <field name="reason" readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_attendance_regularization" model="ir.actions.act_window">
        <field name="name">Attendance Regularizations</field>
        <field name="res_model">hr.attendance.regularization</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
