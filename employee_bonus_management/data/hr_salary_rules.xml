<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Global Rules for custom payroll integrations -->
        <record id="hr_rule_salary_attachments" model="hr.salary.rule">
            <field name="name">Salary Attachments (Loans, Advances, Deductions)</field>
            <field name="sequence" eval="95"/>
            <field name="code">ATT_TOTAL</field>
            <field name="category_id" ref="payroll.DED"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = bool(payslip.input_line_ids.filtered(lambda l: l.code and l.code.startswith('ATT_')))</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = sum(payslip.input_line_ids.filtered(lambda l: l.code and l.code.startswith('ATT_')).mapped('amount'))</field>
        </record>
        
        <record id="hr_rule_employee_bonuses" model="hr.salary.rule">
            <field name="name">Employee Bonuses</field>
            <field name="sequence" eval="85"/>
            <field name="code">BONUS_TOTAL</field>
            <!-- Assuming payroll module uses ALW for allowances -->
            <field name="category_id" ref="payroll.ALW"/> 
            <field name="condition_select">python</field>
            <field name="condition_python">result = bool(payslip.input_line_ids.filtered(lambda l: l.code and l.code.startswith('BONUS_')))</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = sum(payslip.input_line_ids.filtered(lambda l: l.code and l.code.startswith('BONUS_')).mapped('amount'))</field>
        </record>
    </data>
</odoo>
