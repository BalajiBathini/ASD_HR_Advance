<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_bonus_form" model="ir.ui.view">
        <field name="name">hr.bonus.form</field>
        <field name="model">hr.bonus</field>
        <field name="arch" type="xml">
            <form string="Employee Bonus">
                <header>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="employee_id"/>
                            <field name="bonus_month"/>
                        </group>
                        <group>
                            <field name="bonus_type"/>
                            <field name="calculation_base" invisible="bonus_type != 'percentage'" required="bonus_type == 'percentage'"/>
                            <field name="amount"/>
                        </group>
                    </group>
                    <group>
                        <field name="remarks"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_bonus_tree" model="ir.ui.view">
        <field name="name">hr.bonus.list</field>
        <field name="model">hr.bonus</field>
        <field name="arch" type="xml">
            <list string="Employee Bonuses" decoration-info="state == 'approved'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="bonus_month"/>
                <field name="amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_hr_bonus" model="ir.actions.act_window">
        <field name="name">Employee Bonuses</field>
        <field name="res_model">hr.bonus</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Bonus!
            </p>
        </field>
    </record>
</odoo>
