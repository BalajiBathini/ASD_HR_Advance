<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_view_form_extended" model="ir.ui.view">
        <field name="name">hr.leave.view.form.extended</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='number_of_days']" position="after">
                <field name="sandwich_extra_days" readonly="1"
                       invisible="sandwich_extra_days == 0"/>
            </xpath>
        </field>
    </record>
</odoo>
