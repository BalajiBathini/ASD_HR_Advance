<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_leave_encashment_tree" model="ir.ui.view">
        <field name="name">hr.leave.encashment.tree</field>
        <field name="model">hr.leave.encashment</field>
        <field name="arch" type="xml">
            <list string="Leave Encashment">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="leave_type_id"/>
                <field name="el_days"/>
                <field name="amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_hr_leave_encashment_form" model="ir.ui.view">
        <field name="name">hr.leave.encashment.form</field>
        <field name="model">hr.leave.encashment</field>
        <field name="arch" type="xml">
            <form string="Leave Encashment">
                <header>
                    <button name="action_submit" string="Submit" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_approve" string="Approve" type="object" invisible="state != 'submit'" class="oe_highlight" groups="hr_holidays.group_hr_holidays_manager"/>
                    <button name="action_done" string="Validate" type="object" invisible="state != 'approve'" class="oe_highlight" groups="hr_holidays.group_hr_holidays_manager"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ['draft', 'submit', 'approve']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submit,approve,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="leave_type_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="el_days" readonly="state != 'draft'"/>
                            <field name="amount" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_hr_leave_encashment" model="ir.actions.act_window">
        <field name="name">Leave Encashment</field>
        <field name="res_model">hr.leave.encashment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
