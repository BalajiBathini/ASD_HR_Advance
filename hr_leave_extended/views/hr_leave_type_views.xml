<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edit_holiday_status_form_inherit_extended" model="ir.ui.view">
        <field name="name">hr.leave.type.form.inherit.extended</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='configuration']" position="after">
                <group string="Extended Configuration" name="extended_config">
                    <group>
                        <field name="is_carry_forward"/>
                        <field name="carry_forward_max" invisible="is_carry_forward == False"/>
                        <field name="is_encashable"/>
                        <field name="is_paid"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
